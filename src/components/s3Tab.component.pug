.header
    input.form-control.flex-grow-1.w-0(
        *ngIf='editingPath !== null',
        type='text',
        autofocus,
        (keydown.enter)='confirmPath()',
        (keydown.esc)='editingPath = null',
        (blur)='editingPath = null',
        [(ngModel)]='editingPath'
    )
    .breadcrumb(*ngIf='editingPath === null', (dblclick)='editPath()')
        a.breadcrumb-item.text-decoration-none(
            *ngFor='let segment of pathSegments',
            (click)='navigate(segment.location)'
        ) {{segment.name}}

    .breadcrumb-spacer.flex-grow-1.h-100((dblclick)='editPath()')

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='refresh()', [disabled]='!session')
        i.fas.fa-sync-alt.me-1
        div(translate) Refresh

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(*ngIf='!showFilter', (click)='showFilter = true')
        i.fas.fa-filter.me-1
        div(translate) Filter

    ng-container(*ngIf='canWrite')
        button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='createFolder()', [disabled]='!session')
            i.fas.fa-plus.me-1
            div(translate) Create folder

        button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='upload()', [disabled]='!session')
            i.fas.fa-upload.me-1
            div(translate) Upload files

        button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='uploadFolder()', [disabled]='!session')
            i.fas.fa-upload.me-1
            div(translate) Upload folder

.filter-bar.px-3.py-2.border-bottom(*ngIf='showFilter')
    .input-group
        input.form-control(
            type='text',
            placeholder='Filter...',
            autofocus,
            [(ngModel)]='filterText',
            (input)='onFilterChange()',
            (keydown.escape)='clearFilter()'
        )
        button.btn.btn-secondary((click)='clearFilter()')
            i.fas.fa-times

.body(dropZone, (transfer)='uploadDropped($event)')
    .alert.alert-danger.d-flex.align-items-center(*ngIf='error')
        .me-auto {{error}}
        button.btn.btn-secondary.ms-3((click)='connect()', translate) Retry

    div(*ngIf='!session && !error', translate) Connecting
    div(*ngIf='session')
        div(*ngIf='items === null', translate) Loading
        .list-group.list-group-light(*ngIf='items !== null')
            .list-group-item.list-group-item-action.d-flex.align-items-center(
                *ngIf='canGoUp && (!showFilter || !filterText.trim())',
                (click)='goUp()'
            )
                i.fas.fa-fw.fa-level-up-alt
                div(translate) Go up
            .list-group-item.list-group-item-action.d-flex.align-items-center(
                *ngFor='let item of filteredItems',
                (contextmenu)='showContextMenu(item, $event)',
                (click)='open(item)'
            )
                i.fa-fw([class]='getIcon(item)')
                div {{item.name}}
                .me-auto
                .size(*ngIf='!item.isDirectory') {{formatSize(item.size)}}
                .date {{item.modified ? (item.modified|tabbyDate) : ''}}
        .text-muted.text-center.mt-3(*ngIf='items !== null && !items.length && !error', translate) This folder is empty
