.header
    input.form-control.flex-grow-1.w-0(
        *ngIf='editingPath !== null',
        type='text',
        autofocus,
        (keydown.enter)='confirmPath()',
        (keydown.esc)='editingPath = null',
        (blur)='editingPath = null',
        [(ngModel)]='editingPath'
    )
    .breadcrumb(*ngIf='editingPath === null', (dblclick)='editPath()')
        a.breadcrumb-item.text-decoration-none(
            *ngFor='let segment of pathSegments',
            (click)='navigate(segment.location)'
        ) {{segment.name}}

    .breadcrumb-spacer.flex-grow-1.h-100((dblclick)='editPath()')

    .busy.d-flex.align-items-center.me-2(*ngIf='busy')
        i.fas.fa-circle-notch.fa-spin.me-2
        span {{busy}}

    //- In the toolbar rather than in a bar of its own, so that the list doesn't move when it appears
    ng-container(*ngIf='clipboard')
        button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(
            (click)='paste()',
            [disabled]='!canWrite || !!busy',
            [title]='canWrite ? "" : "Open a folder to paste into"'
        )
            i.fas.fa-paste.me-1
            div(*ngIf='clipboard.mode === "copy"') Paste {{clipboard.items.length}} here
            div(*ngIf='clipboard.mode === "cut"') Move {{clipboard.items.length}} here
        button.btn.btn-link.btn-sm.flex-shrink-0.d-flex.me-2((click)='clipboard = null', title='Clear the clipboard')
            i.fas.fa-times

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='refresh()', [disabled]='!session')
        i.fas.fa-sync-alt.me-1
        div(translate) Refresh

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(*ngIf='!showFilter', (click)='showFilter = true')
        i.fas.fa-filter.me-1
        div(translate) Filter

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(
        *ngIf='!canWrite && !fixedBucket',
        (click)='createBucket()',
        [disabled]='!session'
    )
        i.fas.fa-plus.me-1
        div(translate) Create bucket

    ng-container(*ngIf='canWrite')
        button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='createFolder()', [disabled]='!session')
            i.fas.fa-plus.me-1
            div(translate) Create folder

        button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='upload()', [disabled]='!session')
            i.fas.fa-upload.me-1
            div(translate) Upload files

        button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='uploadFolder()', [disabled]='!session')
            i.fas.fa-upload.me-1
            div(translate) Upload folder

.filter-bar.px-3.py-2.border-bottom(*ngIf='showFilter')
    .input-group
        input.form-control(
            type='text',
            placeholder='Filter...',
            autofocus,
            [(ngModel)]='filterText',
            (input)='onFilterChange()',
            (keydown.escape)='clearFilter()'
        )
        button.btn.btn-secondary((click)='clearFilter()')
            i.fas.fa-times
    small.text-muted(*ngIf='nextToken', translate) Only the loaded items are filtered

.body(dropZone, (transfer)='uploadDropped($event)')
    .alert.alert-danger.d-flex.align-items-center(*ngIf='error')
        .me-auto {{error}}
        button.btn.btn-secondary.ms-3(
            *ngIf='authError && usesStoredKey',
            (click)='changeSecretKey()',
            translate
        ) Change secret key
        button.btn.btn-secondary.ms-3((click)='connect()', translate) Retry

    div(*ngIf='!session && !error', translate) Connecting
    div(*ngIf='session')
        div(*ngIf='items === null', translate) Loading
        .list-group.list-group-light(*ngIf='items !== null && (items.length || canGoUp)')
            .list-group-item.columns.d-flex.align-items-center
                input.form-check-input.me-2(
                    *ngIf='canWrite',
                    type='checkbox',
                    [checked]='allSelected',
                    (change)='toggleSelectAll()',
                    title='Select all'
                )
                //- With a selection, its actions take the place of the column titles, so that the rows stay put
                ng-container(*ngIf='!selection.size')
                    a.sortable.me-auto((click)='sortBy("name")')
                        span(translate) Name
                        i.ms-1([class]='sortIcon("name")')
                    a.sortable.size((click)='sortBy("size")')
                        i.me-1([class]='sortIcon("size")')
                        span(translate) Size
                    a.sortable.date((click)='sortBy("modified")')
                        i.me-1([class]='sortIcon("modified")')
                        span(translate) Modified
                ng-container(*ngIf='selection.size')
                    .selection-count.me-auto {{selection.size}} selected
                    ng-container(*ngIf='selectedItems.length === 1')
                        button.btn.btn-link((click)='rename(selectedItems[0])')
                            i.fas.fa-i-cursor.me-1
                            span(translate) Rename
                        button.btn.btn-link((click)='showProperties(selectedItems[0])')
                            i.fas.fa-info-circle.me-1
                            span(translate) Properties
                    button.btn.btn-link((click)='downloadItems(selectedItems)')
                        i.fas.fa-download.me-1
                        span(translate) Download
                    button.btn.btn-link((click)='copyToClipboard(selectedItems, "copy")')
                        i.far.fa-copy.me-1
                        span(translate) Copy
                    button.btn.btn-link((click)='copyToClipboard(selectedItems, "cut")')
                        i.fas.fa-cut.me-1
                        span(translate) Cut
                    button.btn.btn-link.text-danger((click)='deleteItems(selectedItems)')
                        i.fas.fa-trash-alt.me-1
                        span(translate) Delete
                    button.btn.btn-link((click)='clearSelection()', title='Clear the selection')
                        i.fas.fa-times

            .list-group-item.list-group-item-action.d-flex.align-items-center(
                *ngIf='canGoUp && (!showFilter || !filterText.trim())',
                (click)='goUp()'
            )
                input.form-check-input.me-2.invisible(*ngIf='canWrite', type='checkbox', disabled, tabindex='-1')
                i.fas.fa-fw.fa-level-up-alt
                div(translate) Go up
            .list-group-item.list-group-item-action.d-flex.align-items-center(
                *ngFor='let item of filteredItems',
                [class.selected]='isSelected(item)',
                (contextmenu)='showContextMenu(item, $event)',
                (click)='onItemClick(item, $event)'
            )
                input.form-check-input.me-2(
                    *ngIf='canWrite',
                    type='checkbox',
                    [checked]='isSelected(item)',
                    (click)='$event.stopPropagation()',
                    (change)='toggleSelection(item)'
                )
                i.fa-fw([class]='getIcon(item)')
                .name.me-auto {{item.name}}
                .size {{item.isDirectory ? '' : formatSize(item.size)}}
                .date {{item.modified ? (item.modified|tabbyDate) : ''}}

        .text-center.mt-3(*ngIf='nextToken')
            button.btn.btn-secondary((click)='loadMore()', [disabled]='loadingMore')
                i.fas.fa-circle-notch.fa-spin.me-2(*ngIf='loadingMore')
                span(translate) Load more
            .text-muted.mt-1
                small {{items?.length}} loaded
        .text-muted.text-center.mt-3(*ngIf='items !== null && !items.length && !error', translate) This folder is empty
