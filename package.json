{
  "name": "tabby-s3",
  "version": "0.1.0",
  "description": "S3-compatible object storage browser for Tabby",
  "keywords": [
    "tabby-plugin"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "webpack --progress --color",
    "watch": "cross-env TABBY_DEV=1 webpack --progress --color --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "author": "zl0i",
  "license": "MIT",
  "devDependencies": {
    "@angular/common": "^15",
    "@angular/compiler": "^15",
    "@angular/compiler-cli": "^15",
    "@angular/core": "^15",
    "@angular/forms": "^15",
    "@angular/platform-browser": "^15",
    "@aws-sdk/client-s3": "^3.730.0",
    "@aws-sdk/lib-storage": "^3.730.0",
    "@biesbjerg/ngx-translate-extract-marker": "^1",
    "@ng-bootstrap/ng-bootstrap": "^14",
    "@ngtools/webpack": "^15",
    "@ngx-translate/core": "^14",
    "@tabby-gang/to-string-loader": "^1.1.7-beta.2",
    "@types/node": "22",
    "apply-loader": "2.0.0",
    "cross-env": "^7",
    "css-loader": "^6",
    "pug": "3",
    "pug-loader": "^2",
    "rxjs": "^7",
    "sass": "^1",
    "sass-loader": "^13",
    "tabby-core": "1.0.231-nightly.0",
    "tslib": "^2",
    "typescript": "~4.9.5",
    "webpack": "^5",
    "webpack-cli": "^5"
  },
  "peerDependencies": {
    "@angular/common": "^15",
    "@angular/core": "^15",
    "@angular/forms": "^15",
    "@ng-bootstrap/ng-bootstrap": "^14",
    "rxjs": "^7",
    "tabby-core": "*"
  }
}
